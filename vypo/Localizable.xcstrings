        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "vypo schreibt einen Begriff immer genau so. Tipp: Markiere ein Wort in einer beliebigen App und drück %@, um es hinzuzufügen."
          }
        }
      }
    },
    "vypo diagnostics, %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "vypo-Diagnose, %@"
          }
        }
      }
    },
    "vypo doesn’t dictate here, e.g. in apps with confidential content.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "vypo diktiert hier nicht, z. B. in Apps mit vertraulichen Inhalten."
          }
        }
      }
    },
    "vypo idle": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "vypo inaktiv"
          }
        }
      }
    },
    "vypo needs the microphone to listen and Accessibility to read the dictation key and paste text where your cursor is.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "vypo braucht das Mikrofon zum Zuhören und die Bedienungshilfen, um die Diktiertaste zu erkennen und Text dort einzufügen, wo dein Cursor steht."
          }
        }
      }
    },
    "vypo quits and opens again. This takes a second.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "vypo wird beendet und wieder geöffnet. Das dauert eine Sekunde."
          }
        }
      }
    },
    "vypo recognizes which of your languages you’re speaking.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "vypo erkennt, welche deiner Sprachen du sprichst."
          }
        }
      }
    },
    "vypo recognizes which of your languages you’re speaking. Recognition runs on this Mac.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "vypo erkennt, welche deiner Sprachen du sprichst. Die Erkennung läuft auf diesem Mac."
          }
        }
      }
    },
    "vypo recognizes your terms while transcribing, even unusual names.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "vypo erkennt deine Begriffe schon beim Transkribieren, auch ungewöhnliche Namen."
          }
        }
      }
    },
    "vypo types the text wherever your cursor is. Your voice and your text never leave this Mac.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "vypo schreibt den Text dort, wo dein Cursor steht. Deine Stimme und dein Text verlassen diesen Mac nie."
          }
        }
      }
    },
    "vypo understands English and German and recognizes which one you’re speaking. Everything runs on this Mac.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "vypo versteht Englisch und Deutsch und erkennt, welche Sprache du sprichst. Alles läuft auf diesem Mac."
          }
        }
      }
    },
    "vypo understands English and German and recognizes which one you’re speaking. No switching needed.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "vypo versteht Englisch und Deutsch und erkennt, welche Sprache du sprichst. Kein Umschalten nötig."
          }
        }
      }
    },
    "vypo, recording": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "vypo, Aufnahme läuft"
          }
        }
      }
    }
  },
  "version": "1.0"
