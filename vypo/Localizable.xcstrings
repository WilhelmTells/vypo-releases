          }
        }
      }
    },
    "If macOS Dictation is on, turn it off in Keyboard Settings. Otherwise macOS and vypo listen at the same time.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn das Diktieren von macOS an ist, schalte es in den Tastatur-Einstellungen aus. Sonst hören macOS und vypo gleichzeitig zu."
