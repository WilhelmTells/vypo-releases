// Signing for local builds. Put your Apple Developer team ID in Config/Local.xcconfig, which git ignores:
//
//     DEVELOPMENT_TEAM = ABCDE12345
//
// It is the OU of your “Apple Development” certificate:
//
//     security find-certificate -c "Apple Development" -p | openssl x509 -noout -subject
#include? "Local.xcconfig"
